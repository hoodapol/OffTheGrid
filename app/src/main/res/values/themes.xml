<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OffTheGrid" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/otg_bar</item>
        <item name="colorPrimaryVariant">@color/otg_bar_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/otg_accent</item>
        <item name="colorSecondaryVariant">@color/otg_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/otg_surface</item>
        <item name="colorOnSurface">@color/otg_text_primary</item>
        <item name="android:colorBackground">@color/otg_background</item>
        <item name="android:windowBackground">@color/otg_background</item>
        <item name="android:colorBackgroundFloating">@color/otg_surface</item>
        <item name="android:textColorPrimary">@color/otg_text_primary</item>
        <item name="android:textColorSecondary">@color/otg_text_secondary</item>
        <item name="android:textColorHint">@color/otg_text_secondary</item>
        <item name="android:statusBarColor">@color/otg_bar_dark</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="alertDialogTheme">@style/OffTheGrid.AlertDialog</item>
        <item name="popupMenuStyle">@style/Widget.OffTheGrid.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.OffTheGrid.OverflowMenu</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.OffTheGrid.Popup</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.OffTheGrid.Popup</item>
    </style>

    <style name="OffTheGrid.AlertDialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/otg_primary</item>
        <item name="colorOnPrimary">@color/otg_on_primary</item>
        <item name="colorSecondary">@color/otg_accent</item>
        <item name="colorSurface">@color/otg_surface</item>
        <item name="colorOnSurface">@color/otg_text_primary</item>
        <item name="colorControlNormal">@color/otg_text_secondary</item>
        <item name="colorControlActivated">@color/otg_primary</item>
        <item name="android:colorBackground">@color/otg_surface</item>
        <item name="android:colorBackgroundFloating">@color/otg_surface</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:textColorPrimary">@color/otg_text_primary</item>
        <item name="android:textColorSecondary">@color/otg_text_secondary</item>
        <item name="android:textColorHint">@color/otg_text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/otg_text_primary</item>
        <item name="android:windowTitleStyle">@style/OffTheGrid.DialogTitle</item>
        <item name="buttonBarPositiveButtonStyle">@style/OffTheGrid.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/OffTheGrid.DialogButton.Quiet</item>
        <item name="buttonBarNeutralButtonStyle">@style/OffTheGrid.DialogButton.Quiet</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <style name="OffTheGrid.DialogTitle" parent="TextAppearance.AppCompat.Title">
        <item name="android:textColor">@color/otg_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="OffTheGrid.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/otg_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="OffTheGrid.DialogButton.Quiet">
        <item name="android:textColor">@color/otg_text_secondary</item>
    </style>

    <style name="Widget.OffTheGrid.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="Widget.OffTheGrid.OverflowMenu" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/bg_popup</item>
    </style>

    <style name="TextAppearance.OffTheGrid.Popup" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/otg_text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RoundedLogo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">32dp</item>
    </style>
    <style name="Theme.OffTheGrid.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:statusBarColor">@color/otg_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Widget.OffTheGrid.ActionBar" parent="Widget.MaterialComponents.ActionBar.Solid">
        <item name="android:background">@color/otg_background</item>
        <item name="background">@color/otg_background</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
        <item name="titleTextStyle">@style/TextAppearance.OffTheGrid.HiddenTitle</item>
    </style>

    <style name="TextAppearance.OffTheGrid.HiddenTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@android:color/transparent</item>
    </style>

    <style name="ThemeOverlay.OffTheGrid.ActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar">
        <item name="colorControlNormal">@color/otg_text_primary</item>
    </style>

    <style name="Theme.OffTheGrid.Chat">
        <item name="actionBarStyle">@style/Widget.OffTheGrid.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.OffTheGrid.ActionBar</item>
        <item name="android:statusBarColor">@color/otg_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="CircleImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RoundedCover" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">32dp</item>
        <item name="cornerSizeBottomRight">32dp</item>
    </style>

    <style name="RoundedTile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>
    <style name="PolaroidPhoto" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">4dp</item>
    </style>
</resources>